{
  "name": "tixify-orders",
  "version": "1.0.0",
  "description": "Tixify orders-Service: Warenkorb, PayPal-Checkout, Bestellungen, Tickets; notifications-Worker",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/notifications/worker.js",
    "test": "jest --runInBand --coverage"
  },
  "dependencies": {
    "bullmq": "^6.3.16",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/helpers/setupEnv.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/helpers/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}

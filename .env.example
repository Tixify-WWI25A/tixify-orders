# Kopieren nach .env (wird nicht eingecheckt) und Werte eintragen.
# Auf Heroku: heroku config:set NAME=wert -a tixify-orders

# Postgres und Redis (auf Heroku automatisch gesetzt, wenn die Add-ons von "tixify" geteilt werden)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tixify
REDIS_URL=redis://localhost:6379

# Muss in gateway, catalog und orders IDENTISCH sein
JWT_SECRET=

# Gemeinsamer Schlüssel für Aufrufe an den catalog (identisch mit tixify-catalog)
INTERNAL_API_TOKEN=
CATALOG_URL=http://localhost:3001

# PayPal (Sandbox-App im PayPal-Developer-Dashboard)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Nur für den notifications-Worker (Brevo SMTP)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
SENDER_EMAIL=

# Optional
PORT=3002
STALE_PENDING_MINUTES=20

# Höchstens so viele Tickets pro Event und Kunde (Standard 5)
MAX_TICKETS_PER_EVENT=5
